set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
win
restoreDesign ./checkpoints/et4351_route.enc.dat et4351
ecoAddRepeater -cell BUFX2LVT -term accel/iomem_conf_rdata_reg_9_/D
ecoAddRepeater -cell BUFX2LVT -term accel/fft/u_re_reg_9_/D
ecoAddRepeater -cell BUFX2LVT -term accel/fft/v_im_reg_15_/D
